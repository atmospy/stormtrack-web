# Local `supabase start` only. Copy to supabase/.env (gitignored) — values for the Google
# provider referenced from config.toml via env(...). Dummy values are fine unless you test Google sign-in.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=dummy-secret
