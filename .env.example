# StormTrack Web - every environment variable, grouped by who reads it.
# Copy to `.env` (gitignored) for local work. In production these live in GitHub
# (secrets/variables), Cloudflare, Render and Supabase dashboards - see docs/DEPLOY.md.
# Never commit real values.

# ---------------------------------------------------------------- web (apps/web, build-time, PUBLIC)
# Everything PUBLIC_* is embedded in the browser bundle. Safe by design; do not put secrets here.
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321          # local stack; prod: https://<ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=                           # `supabase status` locally; prod: Dashboard > Settings > API (anon/publishable)
PUBLIC_DATA_BASE=/data                              # dev: served from public-data; prod: https://data.<your-domain> (R2 custom domain)
PUBLIC_API_BASE=                                    # prod: https://stormtrack-api.onrender.com (optional until the API ships)
PUBLIC_SITE_URL=http://localhost:5173               # used for auth redirect URLs

# ---------------------------------------------------------------- ingest jobs (services/ingest/*, GitHub Actions secrets)
R2_ACCOUNT_ID=                                      # Cloudflare dashboard > R2 > Overview (right sidebar)
R2_ACCESS_KEY_ID=                                   # R2 > Manage API tokens > Object Read & Write, scoped to ONE bucket
R2_SECRET_ACCESS_KEY=                               # shown once at token creation
R2_BUCKET=                                          # e.g. stormtrack-data
FIRMS_MAP_KEY=                                      # optional: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (fires layer is skipped if empty)

# ---------------------------------------------------------------- API (services/api, Render env vars)
CORS_ORIGINS=http://localhost:5173                  # comma-separated exact origins
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_JWT_SECRET=                                # Dashboard > Settings > API > JWT secret (server only!)
DATA_BASE_URL=http://localhost:5173/data
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info

# ---------------------------------------------------------------- Cloudflare deploy (GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=                               # My Profile > API Tokens > "Edit Cloudflare Workers"-style token with Pages:Edit
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=stormtrack-web                     # GitHub *variable*

# ---------------------------------------------------------------- Supabase CLI / local auth (supabase/.env, not the repo root)
SUPABASE_ACCESS_TOKEN=                              # for `supabase link/db push` (Dashboard > Account > Access Tokens)
SUPABASE_DB_PASSWORD=                               # project DB password chosen at project creation
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=            # Google Cloud OAuth client (local config.toml reads this)
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
